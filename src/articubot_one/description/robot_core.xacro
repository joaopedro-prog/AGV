<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="robot_cad_properties.xacro"/>

    <!-- ====================================================================== -->
    <!-- MATERIAIS VISUAIS DO ROBÔ REAL                                          -->
    <!-- ====================================================================== -->
    <material name="aluminum">
        <color rgba="0.75 0.77 0.80 1.0"/>
    </material>

    <material name="polyurethane_black">
        <color rgba="0.12 0.12 0.14 1.0"/>
    </material>

    <material name="polyurethane_white">
        <color rgba="0.95 0.95 0.98 1.0"/>
    </material>

    <material name="steel_silver">
        <color rgba="0.82 0.82 0.85 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <!-- ====================================================================== -->
    <!-- BASE LINK (Centro geométrico do eixo das rodas motrizes)                -->
    <!-- ====================================================================== -->
    <link name="base_link">
    </link>

    <!-- ====================================================================== -->
    <!-- BASE_FOOTPRINT (Projeção no chão, z = -wheel_radius)                   -->
    <!-- ====================================================================== -->
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 -${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

    <!-- ====================================================================== -->
    <!-- CHASSIS LINK (Estrutura de Alumínio e Suportes dos Rodízios)            -->
    <!-- ====================================================================== -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="chassis">
        <!-- 1. Corpo principal de Alumínio -->
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="aluminum"/>
        </visual>

        <!-- 2. Placas e suportes dos rodízios (Alumínio) -->
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FL_wheel_plate_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FL_wheel_support_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>

        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FR_wheel_plate_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FR_wheel_support_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>

        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BL_wheel_plate_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BL_wheel_support_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>

        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BR_wheel_plate_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BR_wheel_support_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="steel_silver"/>
        </visual>

        <!-- 3. Rodas dos rodízios (Poliuretano) -->
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FL_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_white"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/FR_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_white"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BL_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_white"/>
        </visual>
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/BR_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_white"/>
        </visual>

        <!-- 4. Carcaça da Webcam frontal -->
        <visual>
            <origin xyz="${cad_mesh_xyz}" rpy="${cad_mesh_rpy}"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/Webcam_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>

        <!-- Colisão do Chassi (Caixa robusta otimizada para física contínua no Gazebo) -->
        <collision>
            <origin xyz="0 0 0.060" rpy="0 0 0"/>
            <geometry>
                <box size="0.680 0.480 0.170"/>
            </geometry>
        </collision>

        <!-- Inércia do chassi de Alumínio calculada a partir do volume real da malha -->
        <inertial>
            <origin xyz="${chassis_com}" rpy="0 0 0"/>
            <mass value="${chassis_mass}"/>
            <xacro:chassis_inertia/>
        </inertial>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/Grey</material>
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <!-- ====================================================================== -->
    <!-- RODA MOTRIZ ESQUERDA (Poliuretano)                                      -->
    <!-- ====================================================================== -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 ${wheel_offset_y} 0" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0.04 -0.233888" rpy="${pi} ${pi/2} 0"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/left_wheel1_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="${left_wheel_com}" rpy="0 0 0"/>
            <mass value="${left_wheel_mass}"/>
            <xacro:left_wheel_inertia/>
        </inertial>
    </link>

    <gazebo reference="left_wheel">
        <material>Gazebo/DarkGrey</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0"/>
        <kd value="1.0"/>
        <minDepth value="0.001"/>
    </gazebo>

    <!-- ====================================================================== -->
    <!-- RODA MOTRIZ DIREITA (Poliuretano)                                       -->
    <!-- ====================================================================== -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 ${-wheel_offset_y} 0" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 -0.04 -0.233888" rpy="0 -${pi/2} 0"/>
            <geometry>
                <mesh filename="package://articubot_one/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="polyurethane_black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="${right_wheel_com}" rpy="0 0 0"/>
            <mass value="${right_wheel_mass}"/>
            <xacro:right_wheel_inertia/>
        </inertial>
    </link>

    <gazebo reference="right_wheel">
        <material>Gazebo/DarkGrey</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0"/>
        <kd value="1.0"/>
        <minDepth value="0.001"/>
    </gazebo>

    <!-- ====================================================================== -->
    <!-- 4 RODÍZIOS DE APOIO (FL, FR, BL, BR) - Pontos físicos de rolamento     -->
    <!-- ====================================================================== -->
    <xacro:macro name="caster_contact" params="prefix xyz radius mass *inertia_block">
        <joint name="${prefix}_caster_joint" type="fixed">
            <parent link="chassis"/>
            <child link="${prefix}_caster_wheel"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}_caster_wheel">
            <!-- Esfera de precisão tangente ao solo para rolagem suave -->
            <collision>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${mass}"/>
                <xacro:insert_block name="inertia_block"/>
            </inertial>
        </link>

        <gazebo reference="${prefix}_caster_wheel">
            <material>Gazebo/White</material>
            <mu1 value="0.0"/>
            <mu2 value="0.0"/>
            <kp value="1000000.0"/>
            <kd value="1.0"/>
        </gazebo>
    </xacro:macro>

    <xacro:caster_contact prefix="FL" xyz="${caster_FL_xyz}" radius="${caster_FL_radius}" mass="${caster_FL_mass}">
        <xacro:caster_FL_inertia/>
    </xacro:caster_contact>

    <xacro:caster_contact prefix="FR" xyz="${caster_FR_xyz}" radius="${caster_FR_radius}" mass="${caster_FR_mass}">
        <xacro:caster_FR_inertia/>
    </xacro:caster_contact>

    <xacro:caster_contact prefix="BL" xyz="${caster_BL_xyz}" radius="${caster_BL_radius}" mass="${caster_BL_mass}">
        <xacro:caster_BL_inertia/>
    </xacro:caster_contact>

    <xacro:caster_contact prefix="BR" xyz="${caster_BR_xyz}" radius="${caster_BR_radius}" mass="${caster_BR_mass}">
        <xacro:caster_BR_inertia/>
    </xacro:caster_contact>

</robot>
