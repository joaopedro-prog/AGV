# ==============================================================================
# 99-agv-devices.rules — Regras udev persistentes para o AGV ELETRON (RPi 3B)
# ==============================================================================
# Instalação:
#   sudo cp scripts/rpi/99-agv-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# ATENÇÃO QUANDO ESP32 E RPLIDAR A1 USAREM O MESMO CHIP USB-SERIAL (CP2102 10c4:ea60):
#   Descubra o número de série único de cada placa plugando uma de cada vez:
#     udevadm info -a -n /dev/ttyUSB0 | grep -E "serial|KERNELS"
#   E preencha ATTRS{serial}=="..." ou trave pela porta USB física da RPi 3B
#   (ex: KERNELS=="1-1.2" vs KERNELS=="1-1.3").
# ==============================================================================

# 1. ESP32 DevKit V1 (USB CH340 1a86:7523 ou CP2102 10c4:ea60)
#    Se o RPLIDAR também for CP2102, descomente ATTRS{serial} ou KERNELS específico!
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="agv_esp32", MODE="0666", GROUP="dialout"
# SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0001", SYMLINK+="agv_esp32", MODE="0666", GROUP="dialout"

# 2. UART física GPIO da RPi 3B (Pinos 8/10 <-> ESP32 GPIO 16/17 conforme KiCad Rev 2.0)
#    Permite apontar serial_port: "/dev/agv_esp32" ou "/dev/serial0"
KERNEL=="ttyAMA0", SYMLINK+="agv_esp32_uart", MODE="0660", GROUP="dialout"
KERNEL=="ttyS0",   MODE="0660", GROUP="dialout"

# 3. RPLIDAR A1 (Silicon Labs CP2102: 10c4:ea60)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="agv_lidar", MODE="0666", GROUP="dialout"

# 4. Câmera CSI (bcm2835-v4l2 -> /dev/video0) ou Webcam USB
SUBSYSTEM=="video4linux", ATTR{index}=="0", SYMLINK+="agv_cam", MODE="0666", GROUP="video"

# 5. Acesso ao barramento I2C (MPU6050) e GPIO (Relés K1/K2)
KERNEL=="i2c-[0-9]*", MODE="0660", GROUP="i2c"
KERNEL=="gpiomem",    MODE="0660", GROUP="gpio"
