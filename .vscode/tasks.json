{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AGV: Deploy Robot Code (Rapido)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/rpi/agv_deploy.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "AGV: Deploy Robot Code + AGVLog (estilo RioLog)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/rpi/agv_deploy.ps1",
        "-FollowLogs"
      ],
      "group": "build",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "AGV: Deploy Completo (Force Colcon Build)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/rpi/agv_deploy.ps1",
        "-ForceBuild"
      ],
      "group": "build",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "AGV: AGVLog (Logs ao Vivo da Raspberry)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/rpi/agv_logs.ps1"
      ],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "AGV: Descobrir Robo & Abrir Driver Station (Dashboard)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$d = (& '${workspaceFolder}/scripts/rpi/agv_discover.ps1' -Json) | ConvertFrom-Json; if ($d) { Start-Process \"http://$($d.Host):$($d.WebPort)\"; Write-Host \"Abrindo http://$($d.Host):$($d.WebPort) (via $($d.Method))\" -ForegroundColor Green }"
      ],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
