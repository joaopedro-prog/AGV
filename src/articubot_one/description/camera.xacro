<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!--
      POSICIONAMENTO DA CÂMERA DO AGV
      O chassi tem comprimento de 0.335 m (termina em x = 0.335).
      Posicionamos a câmera à frente do chassi em x = 0.360 m (2.5 cm à frente do para-choque),
      centralizada em y = 0.0 m, na altura z = 0.120 m.
      A câmera é inclinada para baixo (pitch = 0.75 rad ~ 43 graus), apontando diretamente para o chão
      à frente do robô (de 15 cm a 90 cm de distância), com visão 100% livre do chassi e das rodas!
    -->
    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="0.360 0 0.120" rpy="0 0.75 0"/>
    </joint>

    <link name="camera_link">
        <!-- Corpo da câmera -->
        <visual>
            <geometry>
                <box size="0.020 0.040 0.030"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!-- Haste de suporte ligando ao chassi -->
        <visual>
            <origin xyz="-0.020 0 -0.040" rpy="0 0.75 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.080"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.020 0.040 0.030"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.020" y="0.040" z="0.030">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical"></link>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>

        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.15</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.03</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>