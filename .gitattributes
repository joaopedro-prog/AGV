# Forçar quebras de linha UNIX (LF) para scripts executados dentro do Linux/Docker
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xacro text eol=lf
*.urdf text eol=lf
*.world text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
dockerfile text eol=lf
docker-compose.yml text eol=lf

# Scripts em lote do Windows continuam com CRLF
*.bat text eol=crlf
