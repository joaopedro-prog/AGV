<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!--
      ==========================================================================
      POSICIONAMENTO E ANGULAÇÃO DA CÂMERA DO AGV REAL (WEBCAM)
      ==========================================================================
      A carcaça física da Webcam_1 já faz parte do modelo CAD em chassis.
      Este arquivo posiciona a lente óptica no ponto exato da abertura inferior
      do chassi de alumínio, focando a pista e a linha guia à frente do robô.
      ==========================================================================
    -->
    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="${webcam_lens_x} 0.0 ${webcam_lens_z}" rpy="0 1.22 0"/>
    </joint>

    <link name="camera_link">
        <collision>
            <geometry>
                <box size="0.020 0.080 0.020"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${webcam_mass}" x="0.020" y="0.080" z="0.020">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical"></link>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>

        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.35</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
